  { id:4, nome:'Potássio & Nutrição Parenteral',cor:'peach',corD:'peach-d', colorHex:'var(--peach)' }
];

// ================================================================
// STATE
// ================================================================
let userProgress = {}; // { qId: { status:'correct'|'wrong', eliminated:[] } }
let activeBloco = null;
let activeQIdx = 0; // index within bloco questions
let selectedAlt = null;
let answeredCurrent = false;
let timerSec = 0;
let timerInterval = null;
let timerPaused = false;
let imageGallery = []; // { src, correct }
let activeResumo = 0;

// ================================================================
// INIT
// ================================================================
function initApp() {
  document.getElementById('mTotal').textContent = questionsDatabase.length;
  renderBlocos();
  renderResumo(0);
  updateMetrics();
  startTimer();
}

// ================================================================
// TABS
// ================================================================
function switchTab(tab) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tabSimulado').style.display = tab === 'simulado' ? 'block' : 'none';
  document.getElementById('tabResumos').style.display  = tab === 'resumos'  ? 'block' : 'none';
  event.target.classList.add('active');
}

// ================================================================
// BLOCOS
// ================================================================
function renderBlocos() {
  const grid = document.getElementById('blocosGrid');
  grid.innerHTML = '';
  blocosConfig.forEach(b => {
    const qs = questionsDatabase.filter(q => q.bloco === b.id);
    const total = qs.length;
    const resp = qs.filter(q => userProgress[q.id]).length;
    const acertos = qs.filter(q => userProgress[q.id]?.status === 'correct').length;
    const pct = resp > 0 ? Math.round((acertos/resp)*100) : 0;
    const fillColor = pct >= 80 ? 'var(--mint-d)' : pct >= 60 ? 'var(--butter-d)' : pct > 0 ? 'var(--blush-d)' : 'var(--light)';
    const fillW = resp > 0 ? Math.round((acertos/total)*100) : 0;

    grid.innerHTML += `
    <div class="bloco-card ${activeBloco === b.id ? 'active' : ''}" style="border-top: 3px solid ${b.colorHex}" onclick="selectBloco(${b.id})">
      <p class="bloco-num">Bloco ${b.id}</p>
      <p class="bloco-title">${b.nome}</p>
      <p class="bloco-counter">${resp} / ${total} respondidas · ${acertos} acertos</p>
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" style="width:${fillW}%;background:${fillColor};"></div>
      </div>
    </div>`;
  });
}

function selectBloco(bId) {
  activeBloco = bId;
  activeQIdx = 0;
  renderBlocos();
  document.getElementById('questionViewer').style.display = 'block';
  renderQuestion();
  document.getElementById('questionViewer').scrollIntoView({ behavior:'smooth', block:'start' });
}

// ================================================================
// QUESTION RENDER
// ================================================================
function getBlocoQuestions() {
  return questionsDatabase.filter(q => q.bloco === activeBloco);
}

function renderQuestion() {
  const qs = getBlocoQuestions();
  const q  = qs[activeQIdx];
  if (!q) return;

  answeredCurrent = false;
  selectedAlt     = null;

  // Carousel
  const carousel = document.getElementById('qCarousel');
  carousel.innerHTML = '';
  qs.forEach((qq, i) => {
    const prog = userProgress[qq.id];
    let cls = '';
    if (i === activeQIdx)         cls = 'current';
    else if (prog?.status === 'correct') cls = 'correct';
    else if (prog?.status === 'wrong')   cls = 'wrong';
    carousel.innerHTML += `<div class="q-dot ${cls}" onclick="jumpToQ(${i})">${qq.num}</div>`;
  });

  // Meta
  document.getElementById('qMeta').textContent = `Bloco ${q.bloco} · Questão ${q.num} de ${qs.length}`;
  document.getElementById('qText').textContent = q.enunciado;

  // Imagem
  const imgContainer = document.getElementById('qImgContainer');
  const imgEl         = document.getElementById('qImg');
  if (q.imagem) {
    imgEl.src = q.imagem;
    imgContainer.style.display = 'block';
  } else {
    imgContainer.style.display = 'none';
  }

  // Alternativas
  const altsContainer = document.getElementById('alternativesContainer');
  altsContainer.innerHTML = '';
  const prog = userProgress[q.id];
  const eliminated = prog?.eliminated || [];

  q.alternativas.forEach(alt => {
    let extraCls = '';
    if (prog) {
      if (alt.letra === q.correta) extraCls = 'correct';
      else if (alt.letra === prog.chosen) extraCls = 'wrong';
    }
    if (eliminated.includes(alt.letra)) extraCls = 'eliminated';

    altsContainer.innerHTML += `
    <div class="alt-row">
      <button class="alt-btn ${extraCls}" id="alt-${alt.letra}"
        ${prog ? 'disabled' : ''}
        onclick="selectAlt('${alt.letra}')">
        <span class="alt-letter">${alt.letra}</span>
        <span>${alt.texto}</span>
      </button>
      ${!prog ? `<button class="scissors-btn" title="Eliminar alternativa" onclick="eliminateAlt('${alt.letra}')">✂️</button>` : ''}
    </div>`;
  });

  // Gabarito
  const gabPanel = document.getElementById('gabaritoPanel');
  const gabBody   = document.getElementById('gabaritoBody');
  if (prog) {
    gabPanel.style.display = 'block';
    gabBody.innerHTML = `<p style="font-size:13.5px;line-height:1.7;color:var(--muted)">${q.gabarito}</p>`;
  } else {
    gabPanel.style.display = 'none';
    gabBody.innerHTML = '';
  }

  // Botões
  const btnR = document.getElementById('btnResponder');
  const btnP = document.getElementById('btnProximo');
  if (prog) {
    btnR.style.display = 'none';
    btnP.style.display = 'block';
    if (activeQIdx >= qs.length - 1) btnP.textContent = '✅ Bloco concluído';
  } else {
    btnR.style.display = 'block';
    btnR.disabled = true;
    btnP.style.display = 'none';
    btnP.textContent = 'Próxima Questão →';
  }

  // Restore selected if partially chosen
}

function jumpToQ(idx) {
  activeQIdx = idx;
  renderQuestion();
}

function selectAlt(letra) {
  if (answeredCurrent) return;
  selectedAlt = letra;
  document.querySelectorAll('.alt-btn').forEach(b => b.classList.remove('selected'));
  const el = document.getElementById(`alt-${letra}`);
  if (el) el.classList.add('selected');
  document.getElementById('btnResponder').disabled = false;
}

function eliminateAlt(letra) {
  const qs = getBlocoQuestions();
  const q  = qs[activeQIdx];
  if (!userProgress[q.id]) {
    if (!userProgress[q.id]) userProgress[q.id] = {};
    if (!userProgress[q.id].eliminated) userProgress[q.id].eliminated = [];
  }
  const elim = userProgress[q.id].eliminated;
  if (!elim.includes(letra)) elim.push(letra);
  const altBtn = document.getElementById(`alt-${letra}`);
  if (altBtn) altBtn.classList.add('eliminated');
  syncToAPI(q.id, 'eliminated:'+letra, timerSec);
}

function responder() {
  if (!selectedAlt) return;
  const qs = getBlocoQuestions();
  const q  = qs[activeQIdx];
  const isCorrect = selectedAlt === q.correta;

  userProgress[q.id] = {
    ...(userProgress[q.id] || {}),
    status: isCorrect ? 'correct' : 'wrong',
    chosen: selectedAlt
  };

  answeredCurrent = true;

  // Image gallery
  if (q.imagem) {
    imageGallery.push({ src: q.imagem, correct: isCorrect });
    updateGallery();
  }

  syncToAPI(q.id, isCorrect ? 'correct' : 'wrong', timerSec);
  updateMetrics();
  renderBlocos();
  renderQuestion();
}

function proximaQuestao() {
  const qs = getBlocoQuestions();
  if (activeQIdx < qs.length - 1) {
    activeQIdx++;
    renderQuestion();
  } else {
    // bloco terminado
    document.getElementById('questionViewer').style.display = 'none';
    activeBloco = null;
    renderBlocos();
  }
}

// ================================================================
// METRICS
// ================================================================
function updateMetrics() {
  const total  = questionsDatabase.length;
  const resp   = Object.keys(userProgress).filter(k => userProgress[k].status && userProgress[k].status !== 'eliminated').length;
  const acertos= Object.keys(userProgress).filter(k => userProgress[k].status === 'correct').length;
  const pct    = resp > 0 ? Math.round((acertos/resp)*100) : 0;

  document.getElementById('mTotal').textContent        = total;
  document.getElementById('mRespondidas').textContent   = resp;
  document.getElementById('mAcertos').textContent       = acertos;
  document.getElementById('mAproveitamento').textContent= pct + '%';
}

// ================================================================
// TIMER
// ================================================================
function startTimer() {
  timerInterval = setInterval(() => {
    if (!timerPaused) {
      timerSec++;
      updateTimerDisplay();
    }
  }, 1000);
}

function stopTimer() {
  clearInterval(timerInterval);
}

function updateTimerDisplay() {
  const h = String(Math.floor(timerSec/3600)).padStart(2,'0');
  const m = String(Math.floor((timerSec%3600)/60)).padStart(2,'0');
  const s = String(timerSec%60).padStart(2,'0');
  document.getElementById('timerDisplay').textContent = `${h}:${m}:${s}`;
}

function togglePause() {
  timerPaused = !timerPaused;
  const overlay = document.getElementById('pauseOverlay');
  const btn     = document.getElementById('btnPause');
  if (timerPaused) {
    overlay.classList.add('show');
    btn.textContent = '▶ Continuar';
  } else {
    overlay.classList.remove('show');
    btn.textContent = '⏸ Pausar';
  }
}

function finalizarProva() {
  if (!confirm('Finalizar o simulado e ver relatório?')) return;
  stopTimer();
  const resp    = Object.keys(userProgress).filter(k => userProgress[k].status).length;
  const acertos = Object.keys(userProgress).filter(k => userProgress[k].status === 'correct').length;
  const pct     = resp > 0 ? Math.round((acertos/resp)*100) : 0;
  const h = String(Math.floor(timerSec/3600)).padStart(2,'0');
  const m = String(Math.floor((timerSec%3600)/60)).padStart(2,'0');
  const s = String(timerSec%60).padStart(2,'0');

  document.getElementById('reportDesc').textContent = `Tempo total: ${h}:${m}:${s}`;
  document.getElementById('reportStats').innerHTML = `
    <div class="report-stat"><div class="report-stat-n">${resp}</div><div class="report-stat-l">Respondidas</div></div>
    <div class="report-stat"><div class="report-stat-n" style="color:var(--mint-d)">${acertos}</div><div class="report-stat-l">Acertos</div></div>
    <div class="report-stat"><div class="report-stat-n" style="color:var(--butter-d)">${pct}%</div><div class="report-stat-l">Aproveitamento</div></div>
  `;
  document.getElementById('reportModal').classList.add('show');
}

// ================================================================
// IMAGE GALLERY
// ================================================================
function updateGallery() {
  const sec  = document.getElementById('gallerySection');
  const grid = document.getElementById('galleryGrid');
  if (imageGallery.length === 0) { sec.style.display='none'; return; }
  sec.style.display = 'block';
  grid.innerHTML = '';
  imageGallery.forEach(img => {
    grid.innerHTML += `
    <div class="gallery-thumb ${img.correct ? '' : 'wrong-thumb'}" onclick="openModal('${img.src}')">
      <img src="${img.src}" alt="Questão respondida" />
    </div>`;
  });
}

// ================================================================
// MODAL
// ================================================================
function openModal(src) {
  document.getElementById('modalImg').src = src;
  document.getElementById('imgModal').classList.add('show');
}
function closeModal() {
  document.getElementById('imgModal').classList.remove('show');
}

