<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Farmacologia & Terapêutica Aplicada — Bahiana 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
/* =========================================================
   DESIGN TOKENS — baseado em farmacologia_completo.html
   ========================================================= */
:root {
  --cream:   #FAF8F4;
  --blush:   #F5EAEA;
  --sage:    #E6EFEA;
  --sky:     #E6EFF8;
  --lavender:#EDE8F7;
  --butter:  #F7F2E2;
  --rose:    #F0E4E8;
  --mint:    #E0F0E8;
  --peach:   #F7EDE4;
  --lilac:   #EAE4F5;

  --blush-d: #B86060;
  --sage-d:  #5A9070;
  --sky-d:   #4878A8;
  --lav-d:   #6858A8;
  --butter-d:#9A8030;
  --rose-d:  #986070;
  --mint-d:  #3A8858;
  --peach-d: #A06840;
  --lilac-d: #7060A0;

  --text:  #28221E;
  --muted: #706660;
  --light: #A89890;
  --border:rgba(90,70,60,0.1);
  --r: 14px;
  --rs: 8px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'DM Sans', sans-serif;
  background: var(--cream);
  color: var(--text);
  font-size: 15px;
  line-height: 1.7;
  min-height: 100vh;
}

/* =========================================================
   LOGIN
   ========================================================= */
#loginScreen {
  min-height: 100vh;
  background: linear-gradient(150deg,#EDE8F7 0%,#E6EFF8 35%,#E6EFEA 65%,#F5EDE8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.login-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 48px 40px;
  max-width: 420px;
  width: 100%;
  box-shadow: 0 20px 60px rgba(40,34,30,0.08);
}
.login-card h1 {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: 26px;
  color: var(--text);
  margin-bottom: 6px;
}
.login-card .subtitle { font-size: 13px; color: var(--muted); margin-bottom: 32px; }
.form-group { margin-bottom: 18px; }
.form-group label { display: block; font-size: 12px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); margin-bottom: 7px; }
.form-group input {
  width: 100%; padding: 11px 16px;
  border: 1.5px solid var(--border);
  border-radius: var(--rs);
  font-family: 'DM Sans', sans-serif;
  font-size: 14.5px;
  color: var(--text);
  background: var(--cream);
  outline: none;
  transition: border-color .2s;
}
.form-group input:focus { border-color: var(--lav-d); }
.btn-primary {
  width: 100%; padding: 13px;
  background: var(--text);
  color: white;
  border: none; border-radius: var(--rs);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px; font-weight: 500;
  cursor: pointer;
  transition: all .2s;
  letter-spacing: .02em;
}
.btn-primary:hover { background: #3a3230; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(40,34,30,0.18); }
.login-error { color: var(--blush-d); font-size: 13px; margin-top: 10px; display: none; }
.login-badge {
  display: inline-block;
  background: var(--lavender); color: var(--lav-d);
  font-size: 10.5px; font-weight: 500;
  letter-spacing: .07em; text-transform: uppercase;
  padding: 3px 12px; border-radius: 20px; margin-bottom: 20px;
}

/* =========================================================
   APP SHELL
   ========================================================= */
#app { display: none; min-height: 100vh; flex-direction: column; }

/* Header */
.app-header {
  background: linear-gradient(150deg,#EEE8F8 0%,#E6EFF8 35%,#E4EFEA 65%,#F5EDE8 100%);
  padding: 40px 24px 32px;
  text-align: center;
  border-bottom: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}
.app-header::before {
  content:'';position:absolute;width:300px;height:300px;top:-80px;right:-60px;border-radius:50%;
  background:radial-gradient(circle,rgba(160,140,210,.13) 0%,transparent 70%);
}
.header-kicker {
  font-size: 10.5px; font-weight: 600;
  letter-spacing: .12em; text-transform: uppercase;
  color: var(--lav-d); margin-bottom: 10px;
}
.header-title {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: clamp(22px, 4vw, 36px);
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
}
.header-sub { font-size: 13.5px; color: var(--muted); margin-bottom: 24px; }
.user-pill {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.7);
  border: 1px solid var(--border);
  border-radius: 20px; padding: 5px 14px 5px 10px;
  font-size: 12.5px; color: var(--muted);
  margin-bottom: 20px;
}
.user-pill-dot {
  width: 24px; height: 24px; border-radius: 50%;
  background: var(--lavender);
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 600; color: var(--lav-d);
}

/* Tab nav */
.tab-nav {
  display: flex; gap: 8px;
  justify-content: center; flex-wrap: wrap;
  padding: 20px 24px;
  background: rgba(250,248,244,.95);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 100;
}
.tab-btn {
  padding: 8px 22px; border-radius: 30px;
  border: 1.5px solid var(--border);
  background: white;
  font-family: 'DM Sans', sans-serif;
  font-size: 13px; font-weight: 500;
  color: var(--muted);
  cursor: pointer;
  transition: all .2s;
}
.tab-btn:hover { border-color: var(--lav-d); color: var(--lav-d); }
.tab-btn.active {
  background: var(--text); color: white;
  border-color: var(--text);
  box-shadow: 0 4px 12px rgba(40,34,30,0.15);
}

/* =========================================================
   DASHBOARD MÉTRICAS
   ========================================================= */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  padding: 20px 24px;
  max-width: 980px; margin: 0 auto;
}
@media(max-width:680px) { .metrics-grid { grid-template-columns: repeat(2,1fr); } }
.metric-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 16px 18px;
  text-align: center;
}
.metric-num {
  font-family: 'Lora', serif;
  font-size: 28px; font-weight: 600;
  line-height: 1.1; margin-bottom: 4px;
}
.metric-label { font-size: 11.5px; color: var(--muted); font-weight: 500; letter-spacing: .03em; text-transform: uppercase; }

/* =========================================================
   SIMULADO — BLOCOS
   ========================================================= */
.simulado-container { max-width: 980px; margin: 0 auto; padding: 24px; }

.blocos-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 14px; margin-bottom: 28px;
}
@media(max-width:680px) { .blocos-grid { grid-template-columns: 1fr; } }

.bloco-card {
  background: white;
  border: 1.5px solid var(--border);
  border-radius: var(--r);
  padding: 18px 20px;
  cursor: pointer;
  transition: all .2s;
  position: relative; overflow: hidden;
}
.bloco-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(40,34,30,0.08); }
.bloco-card.active { border-color: var(--text); }
.bloco-num {
  font-size: 11px; font-weight: 500; letter-spacing: .08em;
  text-transform: uppercase; color: var(--muted);
  margin-bottom: 4px;
}
.bloco-title { font-family: 'Lora', serif; font-size: 15px; font-weight: 600; margin-bottom: 10px; }
.bloco-counter { font-size: 12px; color: var(--muted); margin-bottom: 8px; }
.progress-bar-wrap {
  height: 5px; background: var(--border);
  border-radius: 4px; overflow: hidden;
}
.progress-bar-fill {
  height: 100%; border-radius: 4px;
  transition: width .5s ease;
}

/* =========================================================
   QUESTÃO VIEWER
   ========================================================= */
.question-panel {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--r);
  overflow: hidden;
}

/* Carousel de números */
.q-carousel {
  display: flex; gap: 6px; flex-wrap: wrap;
  padding: 14px 18px;
  border-bottom: 1px solid var(--border);
  background: var(--cream);
}
.q-dot {
  width: 32px; height: 32px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 500;
  cursor: pointer;
  transition: all .2s;
  border: 1.5px solid var(--border);
  background: white; color: var(--muted);
  flex-shrink: 0;
}
.q-dot:hover { border-color: var(--lav-d); color: var(--lav-d); }
.q-dot.current { background: var(--text); color: white; border-color: var(--text); }
.q-dot.correct { background: var(--mint); color: var(--mint-d); border-color: var(--mint-d); }
.q-dot.wrong   { background: var(--blush); color: var(--blush-d); border-color: var(--blush-d); }

/* Cronômetro */
.timer-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 18px;
  border-bottom: 1px solid var(--border);
  background: var(--cream);
}
.timer-display {
  font-family: 'DM Sans', sans-serif;
  font-size: 22px; font-weight: 600; letter-spacing: .06em;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.timer-btns { display: flex; gap: 8px; }
.timer-btn {
  padding: 5px 14px; border-radius: 20px;
  border: 1.5px solid var(--border);
  background: white; font-size: 12.5px;
  font-family: 'DM Sans', sans-serif;
  cursor: pointer; font-weight: 500;
  transition: all .2s; color: var(--muted);
}
.timer-btn:hover { border-color: var(--text); color: var(--text); }
.timer-btn.danger { border-color: var(--blush-d); color: var(--blush-d); }
.timer-btn.danger:hover { background: var(--blush); }

/* Pause overlay */
.pause-overlay {
  position: fixed; inset: 0;
  background: rgba(40,34,30,0.85);
  z-index: 500;
  display: none; align-items: center; justify-content: center;
  flex-direction: column; gap: 16px;
}
.pause-overlay.show { display: flex; }
.pause-overlay h2 { color: white; font-family: 'Lora',serif; font-size: 28px; font-style: italic; }
.pause-overlay p { color: rgba(255,255,255,.6); font-size: 14px; }

/* Enunciado */
.q-body { padding: 22px 22px 0; }
.q-meta {
  font-size: 11px; font-weight: 500; letter-spacing: .07em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 12px;
}
.q-text { font-size: 14.5px; line-height: 1.75; color: var(--text); margin-bottom: 18px; }
.q-img-container { text-align: center; margin-bottom: 18px; }
.q-img-container img {
  max-width: 100%; border-radius: var(--rs);
  border: 1px solid var(--border);
  cursor: zoom-in;
  transition: transform .2s;
}
.q-img-container img:hover { transform: scale(1.01); }

/* Alternativas */
.alternatives { padding: 0 22px; }
.alt-row {
  display: flex; align-items: flex-start; gap: 10px;
  margin-bottom: 8px; position: relative;
}
.alt-btn {
  flex: 1; display: flex; align-items: flex-start; gap: 10px;
  padding: 11px 14px;
  border: 1.5px solid var(--border);
  border-radius: var(--rs);
  background: white; cursor: pointer;
  text-align: left;
  font-family: 'DM Sans', sans-serif;
  font-size: 13.5px; color: var(--text);
  transition: all .2s;
  width: 100%;
}
.alt-btn:hover:not(:disabled) { border-color: var(--lav-d); background: var(--lavender); }
.alt-btn.selected { border-color: var(--lav-d); background: var(--lavender); }
.alt-btn.correct  { border-color: var(--mint-d); background: var(--mint); }
.alt-btn.wrong    { border-color: var(--blush-d); background: var(--blush); }
.alt-btn.eliminated { opacity: .35; text-decoration: line-through; pointer-events: none; }
.alt-btn:disabled { cursor: default; }
.alt-letter {
  width: 22px; height: 22px; border-radius: 50%;
  background: var(--cream); border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 600; flex-shrink: 0; color: var(--muted);
}
.scissors-btn {
  width: 30px; height: 30px; border-radius: 50%;
  border: 1.5px solid var(--border);
  background: white; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; flex-shrink: 0;
  transition: all .2s; color: var(--muted);
  align-self: center;
}
.scissors-btn:hover { border-color: var(--blush-d); background: var(--blush); }

/* Responder btn */
.q-actions { padding: 18px 22px; display: flex; gap: 10px; }
.btn-responder {
  padding: 11px 28px;
  background: var(--text); color: white;
  border: none; border-radius: var(--rs);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px; font-weight: 500;
  cursor: pointer; transition: all .2s;
}
.btn-responder:disabled {
  background: var(--light); cursor: not-allowed;
}
.btn-responder:not(:disabled):hover { background: #3a3230; }
.btn-proximo {
  padding: 11px 28px;
  background: var(--sage-d); color: white;
  border: none; border-radius: var(--rs);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px; font-weight: 500;
  cursor: pointer; transition: all .2s;
  display: none;
}
.btn-proximo:hover { background: #4a7860; }

/* Gabarito comentado */
.gabarito {
  margin: 0 22px 22px;
  border: 1px solid var(--border);
  border-radius: var(--rs);
  overflow: hidden;
  display: none;
}
.gabarito-head {
  background: var(--sage); padding: 10px 16px;
  font-size: 12px; font-weight: 600;
  color: var(--sage-d); letter-spacing: .05em;
  text-transform: uppercase;
}
.gabarito-body { padding: 14px 16px; }
.gabarito-item {
  padding: 9px 0;
  border-bottom: 1px solid var(--border);
  font-size: 13px; line-height: 1.65;
}
.gabarito-item:last-child { border-bottom: none; padding-bottom: 0; }
.gabarito-item strong { font-weight: 600; color: var(--text); }
.gabarito-item.correct-item strong { color: var(--mint-d); }
.gabarito-item.wrong-item strong { color: var(--blush-d); }

/* Galeria retroativa */
.gallery-section {
  padding: 20px 24px;
  max-width: 980px; margin: 0 auto;
}
.gallery-title {
  font-size: 11px; font-weight: 500; letter-spacing: .07em;
  text-transform: uppercase; color: var(--muted);
  margin-bottom: 12px;
}
.gallery-grid { display: flex; gap: 10px; flex-wrap: wrap; }
.gallery-thumb {
  width: 72px; height: 72px;
  border-radius: var(--rs); overflow: hidden;
  cursor: zoom-in; border: 2.5px solid var(--mint-d);
  transition: transform .2s;
}
.gallery-thumb:hover { transform: scale(1.05); }
.gallery-thumb img { width: 100%; height: 100%; object-fit: cover; }
.gallery-thumb.wrong-thumb { border-color: var(--blush-d); }

/* =========================================================
   MODAL ZOOM
   ========================================================= */
#imgModal {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.92);
  z-index: 1000;
  display: none; align-items: center; justify-content: center;
  cursor: zoom-out;
}
#imgModal.show { display: flex; }
#imgModal img { max-width: 92vw; max-height: 88vh; border-radius: 8px; }

/* =========================================================
   RELATÓRIO FINAL
   ========================================================= */
#reportModal {
  position: fixed; inset: 0;
  background: rgba(40,34,30,0.7);
  backdrop-filter: blur(6px);
  z-index: 600;
  display: none; align-items: center; justify-content: center;
  padding: 24px;
}
#reportModal.show { display: flex; }
.report-card {
  background: white; border-radius: 20px;
  max-width: 500px; width: 100%;
  padding: 36px; text-align: center;
  box-shadow: 0 20px 60px rgba(0,0,0,0.2);
}
.report-card h2 { font-family: 'Lora',serif; font-size: 26px; margin-bottom: 6px; }
.report-card p { color: var(--muted); font-size: 14px; margin-bottom: 24px; }
.report-stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 24px; }
.report-stat { background: var(--cream); border-radius: var(--rs); padding: 14px; }
.report-stat-n { font-family: 'Lora',serif; font-size: 28px; font-weight: 600; }
.report-stat-l { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; margin-top: 2px; }
.btn-fechar {
  padding: 11px 28px;
  background: var(--text); color: white;
  border: none; border-radius: var(--rs);
  font-size: 14px; font-weight: 500;
  cursor: pointer; font-family: 'DM Sans',sans-serif;
}

/* =========================================================
   RESUMOS
   ========================================================= */
.resumos-container { max-width: 980px; margin: 0 auto; padding: 24px; }
.resumo-nav {
  display: flex; gap: 8px; flex-wrap: wrap;
  margin-bottom: 28px;
}
.resumo-tab {
  padding: 8px 20px; border-radius: 30px;
  border: 1.5px solid var(--border);
  background: white;
  font-family: 'DM Sans', sans-serif;
  font-size: 13px; font-weight: 500;
  color: var(--muted);
  cursor: pointer; transition: all .2s;
}
.resumo-tab:hover { border-color: var(--sky-d); color: var(--sky-d); }
.resumo-tab.active { background: var(--text); color: white; border-color: var(--text); }

/* Bento grid */
.bento { display: grid; gap: 14px; }
.bento-2 { grid-template-columns: 1fr 1fr; }
.bento-3 { grid-template-columns: 2fr 1fr; }
.bento-full { grid-template-columns: 1fr; }
@media(max-width:700px) { .bento-2, .bento-3 { grid-template-columns: 1fr; } }

.bento-card {
  border-radius: var(--r);
  padding: 20px 22px;
  border: 1px solid transparent;
}
.bento-card h3 {
  font-family: 'Lora', serif; font-size: 16px;
  font-weight: 600; margin-bottom: 10px;
}
.bento-card p { font-size: 13.5px; color: var(--muted); line-height: 1.7; }
.bento-card ul { padding-left: 18px; }
.bento-card li { font-size: 13.5px; color: var(--muted); line-height: 1.65; margin-bottom: 5px; }

/* Cores bento */
.bc-sky    { background: var(--sky);    border-color: rgba(72,120,168,.18); }
.bc-sky    h3 { color: var(--sky-d); }
.bc-blush  { background: var(--blush);  border-color: rgba(184,96,96,.18); }
.bc-blush  h3 { color: var(--blush-d); }
.bc-sage   { background: var(--sage);   border-color: rgba(90,144,112,.18); }
.bc-sage   h3 { color: var(--sage-d); }
.bc-lav    { background: var(--lavender);border-color: rgba(104,88,168,.18); }
.bc-lav    h3 { color: var(--lav-d); }
.bc-butter { background: var(--butter); border-color: rgba(154,128,48,.18); }
.bc-butter h3 { color: var(--butter-d); }
.bc-rose   { background: var(--rose);   border-color: rgba(152,96,112,.18); }
.bc-rose   h3 { color: var(--rose-d); }
.bc-mint   { background: var(--mint);   border-color: rgba(58,136,88,.18); }
.bc-mint   h3 { color: var(--mint-d); }
.bc-peach  { background: var(--peach);  border-color: rgba(160,104,64,.18); }
.bc-peach  h3 { color: var(--peach-d); }
.bc-lilac  { background: var(--lilac);  border-color: rgba(112,96,160,.18); }
.bc-lilac  h3 { color: var(--lilac-d); }
.bc-white  { background: white; border-color: var(--border); }
.bc-white  h3 { color: var(--text); }

/* Alert strips */
.alert-strip {
  padding: 10px 15px; border-radius: var(--rs);
  font-size: 13px; line-height: 1.6; margin: 8px 0;
  border-left: 3px solid;
}
.as-warn  { background: var(--butter); border-color: var(--butter-d); color: #7A6020; }
.as-danger{ background: var(--blush);  border-color: var(--blush-d);  color: #804040; }
.as-info  { background: var(--sky);    border-color: var(--sky-d);    color: #3A6090; }
.as-ok    { background: var(--mint);   border-color: var(--mint-d);   color: #2A6840; }

/* Table in resumo */
.mini-table { width: 100%; border-collapse: collapse; font-size: 12.5px; margin-top: 8px; }
.mini-table th { text-align: left; padding: 6px 8px; font-weight: 500; font-size: 11px; color: var(--muted); border-bottom: 1px solid var(--border); text-transform: uppercase; letter-spacing: .04em; }
.mini-table td { padding: 7px 8px; border-bottom: 1px solid var(--border); color: var(--text); vertical-align: top; font-size: 12.5px; }
.mini-table tr:last-child td { border-bottom: none; }
.mini-table tr:hover td { background: rgba(0,0,0,.02); }

/* Tag pills */
.tag-pill {
  display: inline-block;
  font-size: 11.5px; padding: 2px 10px;
  border-radius: 20px; margin: 2px; font-weight: 500;
}
.tp-sage   { background: var(--sage);    color: var(--sage-d); }
.tp-sky    { background: var(--sky);     color: var(--sky-d); }
.tp-blush  { background: var(--blush);   color: var(--blush-d); }
