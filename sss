const API_URL = "SUA_URL_DA_API_AQUI";

// ================================================================
// AUTH
// ================================================================
const CLASS_PASSWORD = "bahiana2026";
let currentUser = null;

function doLogin() {
  const name = document.getElementById('loginName').value.trim();
  const pass = document.getElementById('loginPass').value.trim();
  if (!name) { alert('Digite seu nome.'); return; }
  if (pass !== CLASS_PASSWORD) {
    document.getElementById('loginError').style.display = 'block';
    return;
  }
  currentUser = name;
  document.getElementById('loginError').style.display = 'none';
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('app').style.display = 'flex';
  document.getElementById('userName').textContent = name;
  document.getElementById('userInitial').textContent = name.charAt(0).toUpperCase();
  loadProgressFromAPI();
  initApp();
}

document.getElementById('loginPass').addEventListener('keydown', e => { if (e.key==='Enter') doLogin(); });
document.getElementById('loginName').addEventListener('keydown', e => { if (e.key==='Enter') doLogin(); });

function doLogout() {
  if (confirm('Deseja sair?')) {
    currentUser = null;
    document.getElementById('app').style.display = 'none';
    document.getElementById('loginScreen').style.display = 'flex';
    stopTimer();
  }
}

// ================================================================
// API SYNC
// ================================================================
async function syncToAPI(questionId, status, timeSpent) {
  if (!API_URL || API_URL === "SUA_URL_DA_API_AQUI") return;
  try {
    await fetch(API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        usuario: currentUser,
        questao_id: questionId,
        status: status,
        tempo_gasto: timeSpent,
        timestamp: new Date().toISOString()
      })
    });
  } catch(e) { console.warn('API sync failed:', e); }
}

async function loadProgressFromAPI() {
  if (!API_URL || API_URL === "SUA_URL_DA_API_AQUI") return;
  try {
    const res = await fetch(`${API_URL}?usuario=${encodeURIComponent(currentUser)}`);
    const data = await res.json();
    if (Array.isArray(data)) {
      data.forEach(row => {
        if (row.usuario === currentUser && row.questao_id) {
          userProgress[row.questao_id] = { status: row.status };
        }
      });
    }
    renderBlocos();
    updateMetrics();
  } catch(e) { console.warn('API load failed:', e); }
}

