   {type:"badge",label:"Tratamento Graves",items:["Metimazol (antitireoidiano 1ª linha)","Propranolol (sintomas adrenérgicos)","Radioiodo (definitivo)","Cirurgia (bócio grande, compressão)"]},
   {type:"alert",text:"Doença de Graves: TRAb é anticorpo PATOGNOMÔNICO. Tireoidite Hashimoto: anti-TPO + anti-Tireoglobulina."}
  ]},
  {color:"card-pink",icon:"🔍",title:"Abordagem do Nódulo",content:[
   {type:"numbered",items:["TSH: se baixo → cintilografia (nódulo quente=benigno)","Se TSH normal/alto → USG tireoidiana","Características suspeitas: hipoecogênico, sólido, microcalcificações, margens irregulares, vascularização central","PAAF: nódulo ≥1cm suspeito ou ≥1,5cm indeterminado","Bethesda I-II: observar; III-IV: repetir ou cirurgia; V-VI: cirurgia"]},
   {type:"alert",text:"Doença de Plummer = adenoma tóxico = nódulo QUENTE na cintilografia."}
  ]},
  {color:"card-indigo",icon:"🏥",title:"HAS Secundária — Tireoid",content:[
   {type:"table",headers:["Condição","Padrão HAS"],rows:[["Hipotireoidismo","Diastólica (↓DC, vasoconstrição)"],["Hipertireoidismo","Sistólica (↑FC, ↑DC)"],["Hiperaldo primário","HAS+hipocalemia"],["SAHOS","HAR, non-dipper"]]},
   {type:"alert",text:"SAHOS é a causa mais prevalente de HAS resistente. Hiperaldosteronismo primário: suspeitar com hipocalemia inexplicada."}
  ]}
 ]},
 {id:"nefro",label:"Nefrologia",tag:"#3b82f6",cards:[
  {color:"card-blue",icon:"🫘",title:"DRC — Classificação",content:[
   {type:"table",headers:["Estágio","TFG","Albuminúria"],rows:[["G1","≥90 (com dano)","A1:<30 | A2:30-300 | A3:>300"],["G2","60-89",""],["G3a","45-59",""],["G3b","30-44",""],["G4","15-29",""],["G5","<15","(diálise)"]]},
   {type:"alert",text:"DRC = TFG<60 OU marcador de dano renal por ≥3 meses. Anemia na DRC: deficiência de eritropoietina → EPO exógena."}
  ]},
  {color:"card-indigo",icon:"⚠️",title:"IRA — Tipos",content:[
   {type:"table",headers:["Tipo","Causa","FENa","EAS"],rows:[["Pré-renal","Hipovolemia, sepse","<1%","Cilindros granulares"],["NTA isquêmica","Hipoperfusão persistente",">2%","Cilindros castanhos"],["NTA nefrotóxica","Contraste, aminoglicosídeos",">2%",""],["Pós-renal","Obstrução","Variável","Hematúria"]]},
   {type:"alert",text:"AINE: bloqueia prostaglandinas vasodilatadoras → IRA pré-renal em idosos, DRC, ICC. NTA isquêmica é a + comum na UTI."}
  ]},
  {color:"card-teal",icon:"🧪",title:"Síndromes Renais",content:[
   {type:"table",headers:["Síndrome","Proteinúria","Hematúria","Características"],rows:[["Nefrótica",">3,5g/dia","Ausente","Hipoalbuminemia, edema, hiperlipidemia"],["Nefrítica","<3,5g/dia","Dismórfica","HAS, oligúria, azotemia"]]},
   {type:"alert",text:"LES + proteinúria>3g + hematúria = biópsia renal OBRIGATÓRIA para classificação histológica (ISN/RPS Classe I-VI)."}
  ]},
  {color:"card-violet",icon:"💊",title:"Anti-hipertensivo na DRC",content:[
   {type:"badge",label:"DRC + Proteinúria ≥300mg/g",items:["IECA ou BRA: 1ª escolha (nefroproteção)","Meta PA: <130×80 mmHg em DRC","Adicionar BCC ou tiazídico se necessário","Evitar: duplo bloqueio IECA+BRA"]},
   {type:"alert",text:"METFORMINA: contraindicada com TFG<30. iSGLT2: reduzem progressão da DRC mesmo sem DM (CREDENCE, DAPA-CKD)."}
  ]}
 ]},
 {id:"pneumo",label:"Pneumologia",tag:"#0ea5e9",cards:[
  {color:"card-blue",icon:"🌬️",title:"Asma — Controle",content:[
   {type:"table",headers:["Controle","Critérios"],rows:[["Controlada","0 critérios nas últimas 4 semanas"],["Parcialmente controlada","1-2 critérios"],["Não controlada","≥3 critérios"]]},
   {type:"badge",label:"Critérios de não controle",items:["Sintomas diurnos >2×/semana","Limitação de atividade","Sintomas/despertar noturno","Necessidade de SABA >2×/semana"]},
   {type:"alert",text:"Peakflow ≥80% = controlada. <80% = necessidade de reavaliação. CI+LABA é o padrão do Step 3."}
  ]},
  {color:"card-sky",icon:"💨",title:"DPOC",content:[
   {type:"badge",label:"Diagnóstico e Exacerbação",items:["Diagnóstico: VEF1/CVF<70% pós-BD","Exacerbação viral: ~50% (influenza, rhinovirus)","Exacerbação bacteriana: escarro purulento → AB","AB indicado: Amoxicilina-clavulanato ou quinolona respiratória","Corticoide sistêmico: prednisolona 40mg/5 dias"]},
   {type:"alert",text:"Alfa-1 antitripsina: suspeitar em DPOC jovem (<45 anos), não tabagista, hiperinsuflação em bases pulmonares."}
  ]},
  {color:"card-emerald",icon:"🏥",title:"PAC — CURB-65",content:[
   {type:"table",headers:["Letra","Critério","Ponto"],rows:[["C","Confusão mental","1"],["U","Ureia >43 mg/dL","1"],["R","FR ≥30 irpm","1"],["B","PAS<90 ou PAD<60","1"],["65","Idade ≥65 anos","1"]]},
   {type:"badge",label:"Conduta por pontuação",items:["0-1: Ambulatorial (amoxicilina-clavulanato)","2: Internação","≥3: UTI (cefalosporina 3ª + macrolídeo)"]}
  ]},
  {color:"card-teal",icon:"🦠",title:"Tuberculose",content:[
   {type:"badge",label:"Diagnóstico",items:["Rx tórax: padrão apical com cavidades","Baciloscopia (2 amostras) e TRM-TB","PPD: ≥5mm em imunossuprimidos; ≥10mm em geral","Cultura: padrão-ouro, demora 6-8 semanas"]},
   {type:"alert",text:"TB latente (IGRA ou PPD positivo sem doença): Isoniazida 6-9 meses. TB ativa: RIPE por 6 meses."}
  ]}
 ]},
 {id:"gastro",label:"Gastro & Infecto",tag:"#16a34a",cards:[
  {color:"card-emerald",icon:"🔥",title:"DRGE & Dispepsia",content:[
   {type:"badge",label:"Sinais de alarme (EDA obrigatória)",items:["Disfagia/odinofagia progressiva","Perda de peso >5% em 3 meses","Hematêmese/melena","Anemia ferropriva inexplicada","Massa abdominal palpável","Idade >45 anos com sintomas novos"]},
   {type:"alert",text:"H. pylori: 'test and treat' em <45 anos sem alarme. DRGE sem alarme: IBP 8 semanas + MEV."}
  ]},
  {color:"card-teal",icon:"🫁",title:"Hepatologia",content:[
   {type:"table",headers:["Padrão","Enzimas","Causa principal"],rows:[["Hepatocelular","AST/ALT↑↑, AST/ALT>2 = alcoólica","Viral, alcoólica, autoimune"],["Colestático","FA/GGT↑↑","Coledocolitíase, neoplasia"],["Misto","Tudo ↑","Cirrose, metástase"]]},
   {type:"alert",text:"Colestase: 1º exame = USG abdominal. Dilatação biliar = extrahepática (CPRE). Sem dilatação = intra-hepática (biópsia)."}
  ]},
  {color:"card-green",icon:"🦟",title:"Arboviroses",content:[
   {type:"table",headers:["Vírus","Diferencial"],rows:[["Dengue","Febre alta, mialgia, cefaleia retro-orbital, trombocitopenia"],["Zika","Febre BAIXA, rash, conjuntivite, artralgia LEVE"],["Chikungunya","Febre ALTA, artralgia INTENSA/incapacitante, rash"]]},
   {type:"alert",text:"Sinais de alarme da Dengue surgem no 3-4º dia (defervescência): dor abdominal intensa, vômitos, ascite, sangramento mucoso, hepatomegalia, letargia."}
  ]},
  {color:"card-amber",icon:"🧬",title:"HIV — PEP & PrEP",content:[
   {type:"numbered",items:["PEP: pós-exposição de risco → iniciar em até 72h","Esquema PEP: tenofovir + lamivudina + dolutegravir × 28 dias","Realizar teste rápido HIV antes de iniciar","PrEP: pré-exposição, em populações de alto risco","PrEP: tenofovir + entricitabina diariamente"]},
   {type:"alert",text:"PEP após 72h: ineficaz. CD4 e carga viral não são detectáveis nas primeiras semanas da infecção aguda."}
  ]}
 ]},
 {id:"hemato",label:"Hematologia",tag:"#db2777",cards:[
  {color:"card-pink",icon:"🩸",title:"Anemias — Classificação",content:[
   {type:"table",headers:["VCM","Tipo","Principais causas"],rows:[["<80 (microcítica)","Ferropriva, talassemia","Ferropriva: ferritina↓, ↑TIBC"],["80-100 (normocítica)","DRC, hemólise, aplasia","DRC: EPO↓; hemólise: reticulocitose"],[">100 (macrocítica)","B12, folato, hipotireoid.","B12: neuro; folato: sem neuro"]]},
   {type:"alert",text:"DHL muito elevada (>600) + macrocitose + neutrófilos hipersegmentados = megaloblástica. Homem ≥50 com ferropriva: colonoscopia obrigatória."}
  ]},
  {color:"card-rose",icon:"💊",title:"Deficiência de B12",content:[
   {type:"badge",label:"Causas",items:["Anemia perniciosa (anti-fator intrínseco)","Gastrectomia/cirurgia bariátrica","Vegetarianismo estrito","DRC avançada","Metformina prolongada (↓absorção B12)"]},
   {type:"badge",label:"Hemograma B12",items:["VCM >100 (macrocitose)","Neutrófilos hipersegmentados","Macro-ovalócitos","Reticulocitopenia","DHL muito elevada"]},
   {type:"alert",text:"Parestesia + anemia megaloblástica = Degeneração Combinada Subaguda da medula (B12). VITILIGO + megaloblástica = anemia perniciosa autoimune."}
  ]},
  {color:"card-violet",icon:"🔴",title:"Falciforme",content:[
   {type:"badge",label:"Crise vasooclusiva — Tratamento",items:["Hidratação venosa vigorosa","Morfina EV titulada (opioide de escolha)","O2 suplementar se SaO2<95%","Ácido fólico diário","Hidroxiureia (profilaxia de crises)"]},
   {type:"alert",text:"NUNCA tramadol como 1ª linha em crise grave. Morfina EV em dose adequada — não subdosar por medo."}
  ]},
  {color:"card-indigo",icon:"⚡",title:"CIVD & Coagulopatias",content:[
   {type:"table",headers:["Doença","Plaquetas","TP/INR","TTPA","Fibrinogênio"],rows:[["CIVD","↓↓","↑","↑","↓↓"],["PTI","↓↓","Normal","Normal","Normal"],["Von Willebrand","Normal","Normal","↑","Normal"],["Hemofilia A","Normal","Normal","↑","Normal"]]},
   {type:"alert",text:"CIVD pós-parto: hipofibrinogenemia <100mg/dL + plaquetopenia = diagnóstico. Repor: plasma fresco, crioprecipitado (fibrinogênio), plaquetas."}
  ]}
 ]}
];

// ════════════════════════════════════════════════════
// STATE
// ════════════════════════════════════════════════════
let currentUser = null;
let userProgress = {}; // {qId: respostaIdx}
let filtroTema = "Todos";

// ════════════════════════════════════════════════════
// AUTH / LOCAL STORAGE
// ════════════════════════════════════════════════════
function doLogin(){
  const inp = document.getElementById('login-input');
  const name = inp.value.trim();
  if(!name){inp.style.borderColor='#e11d48';return;}
  currentUser = name;
  // load progress
  const saved = localStorage.getItem('ci3_progress_' + name);
  userProgress = saved ? JSON.parse(saved) : {};
  document.getElementById('user-display').textContent = name;
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app').classList.add('visible');
  renderAll();
}

function doLogout(){
  currentUser = null; userProgress = {}; filtroTema = "Todos";
  document.getElementById('app').classList.remove('visible');
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('login-input').value = '';
}

function saveProgress(){
  if(currentUser) localStorage.setItem('ci3_progress_' + currentUser, JSON.stringify(userProgress));
}

// ════════════════════════════════════════════════════
// TABS
// ════════════════════════════════════════════════════
function showTab(tab, btn){
  document.querySelectorAll('.nav-pill').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  const simuladoEl = document.getElementById('tab-simulado');
  const resumosEl = document.getElementById('tab-resumos');
  if(tab==='simulado'){
    simuladoEl.style.display='block';
    resumosEl.style.display='none';
  } else {
    simuladoEl.style.display='none';
    resumosEl.style.display='block';
    renderResumosTabs();
    renderResumoContent();
  }
}

// ════════════════════════════════════════════════════
// RENDER — METRICS
// ════════════════════════════════════════════════════
function renderMetrics(){
  const total = QUESTOES.length;
  const resp = Object.keys(userProgress).length;
  const acertos = Object.entries(userProgress).filter(([id,val])=>{
    const q = QUESTOES.find(q=>q.id===parseInt(id));
    return q && val===q.correta;
  }).length;
  const aprov = resp>0 ? Math.round(acertos/resp*100):0;
  const colors = ['#7c3aed','#2563eb','#059669','#d97706'];
  const data = [
    {label:'Total de Questões',value:total,sub:'no banco'},
    {label:'Respondidas',value:resp,sub:`de ${total}`},
    {label:'Acertos',value:acertos,sub:`de ${resp}`},
    {label:'Aproveitamento',value:aprov+'%',sub:resp>0?`${acertos}/${resp}`:'—'}
  ];
  document.getElementById('metrics-area').innerHTML = data.map((d,i)=>`
    <div class="metric-card" style="border-left:3px solid ${colors[i]}">
      <div class="metric-label">${d.label}</div>
      <div class="metric-value" style="color:${colors[i]}">${d.value}</div>
      ${d.sub?`<div class="metric-sub">${d.sub}</div>`:''}
    </div>
  `).join('');
}

// ════════════════════════════════════════════════════
// RENDER — TEMA CARDS
// ════════════════════════════════════════════════════
function getTemaStats(tema){
  const qs = QUESTOES.filter(q=>q.tema===tema);
  const resp = qs.filter(q=>userProgress[q.id]!==undefined);
  const acert = resp.filter(q=>userProgress[q.id]===q.correta);
  const pct = resp.length>0?Math.round(acert.length/resp.length*100):0;
  return {total:qs.length, resp:resp.length, acertos:acert.length, pct};
}

function renderTemas(){
  const temas = [...new Set(QUESTOES.map(q=>q.tema))];
  const allStat = {
    total:QUESTOES.length,
    resp:Object.keys(userProgress).length,
    acertos:Object.entries(userProgress).filter(([id,v])=>{const q=QUESTOES.find(q=>q.id===parseInt(id));return q&&v===q.correta;}).length,
    pct:0
  };
  allStat.pct = allStat.resp>0?Math.round(allStat.acertos/allStat.resp*100):0;
  
  const allCards = [...temas, 'Todos'].map(tema=>{
    const s = tema==='Todos'?allStat:getTemaStats(tema);
    const pct = s.pct;
    const barColor = pct>=80?'#4ade80':pct>=60?'#facc15':'#f87171';
    const glow = pct>=80?`box-shadow:0 0 6px #4ade8066`:''
    const active = filtroTema===tema;
    return `
      <div class="tema-card ${active?'active':''}" onclick="setFiltro('${tema}')">
        <div class="tema-name">${tema}</div>
        <div class="tema-count">${s.resp}/${s.total} respondidas</div>
        <div class="progress-bar-bg">
          <div class="progress-bar-fill" style="width:${s.resp>0?pct:0}%;background:${barColor};${glow}"></div>
        </div>
        ${s.resp>0?`<div class="tema-pct" style="color:${barColor}">${pct}%</div>`:''}
      </div>
    `;
  }).join('');
  document.getElementById('tema-grid').innerHTML = allCards;
}

function setFiltro(tema){
  filtroTema = filtroTema===tema?'Todos':tema;
  renderTemas();
  renderQuestoes();
  document.getElementById('questoes-title').textContent = filtroTema==='Todos'?'Todas as questões':filtroTema;
}

// ════════════════════════════════════════════════════
// RENDER — QUESTOES
// ════════════════════════════════════════════════════
function renderQuestoes(){
  const qs = filtroTema==='Todos'?QUESTOES:QUESTOES.filter(q=>q.tema===filtroTema);
  document.getElementById('questoes-count').textContent = `${qs.length} questões`;
  const letras = ['A','B','C','D','E'];
  document.getElementById('questoes-area').innerHTML = qs.map((q,idx)=>{
    const answered = userProgress[q.id]!==undefined;
    const selected = userProgress[q.id];
    const alts = q.alternativas.map((alt,i)=>{
      let cls = '';
      if(answered){
        if(i===q.correta) cls='correta';
        else if(i===selected && i!==q.correta) cls='errada';
        else cls='neutra';
      }
      const disabled = answered?'disabled':'';
      return `<button class="alt-btn ${cls}" onclick="responder(${q.id},${i})" ${disabled}>
        <span class="alt-letra">${letras[i]||i}</span>
        <span class="alt-text">${alt}</span>
      </button>`;
    }).join('');
    const gabarito = answered?`
      <div class="gabarito-box">
        <div class="gabarito-label">💡 Gabarito Comentado</div>
        <div class="gabarito-text">${q.gabarito}</div>
      </div>`:'' ;
    return `
      <div class="questao-card" id="qcard-${q.id}">
        <div class="questao-header">
          <div class="questao-num">${idx+1}</div>
          <div>
            <div class="questao-tema-badge">${q.tema}</div>
            <div class="questao-enunciado">${q.enunciado}</div>
          </div>
        </div>
        <div class="alternativas">${alts}</div>
        ${gabarito}
      </div>
    `;
  }).join('');
}

function responder(qId, altIdx){
  if(userProgress[qId]!==undefined) return;
  userProgress[qId] = altIdx;
  saveProgress();
  renderMetrics();
  renderTemas();
  // Re-render just this card
  const q = QUESTOES.find(q=>q.id===qId);
  const qs = filtroTema==='Todos'?QUESTOES:QUESTOES.filter(q=>q.tema===filtroTema);
  const idx = qs.findIndex(q=>q.id===qId);
  const letras = ['A','B','C','D','E'];
  const selected = altIdx;
  const answered = true;
  const alts = q.alternativas.map((alt,i)=>{
    let cls = '';
    if(i===q.correta) cls='correta';
    else if(i===selected && i!==q.correta) cls='errada';
    else cls='neutra';
    return `<button class="alt-btn ${cls}" disabled>
      <span class="alt-letra">${letras[i]||i}</span>
      <span class="alt-text">${alt}</span>
    </button>`;
  }).join('');
  const card = document.getElementById('qcard-'+qId);
  if(card){
    card.querySelector('.alternativas').innerHTML = alts;
    const existing = card.querySelector('.gabarito-box');
    if(existing) existing.remove();
    card.insertAdjacentHTML('beforeend',`
      <div class="gabarito-box">
        <div class="gabarito-label">💡 Gabarito Comentado</div>
        <div class="gabarito-text">${q.gabarito}</div>
      </div>
    `);
  }
}

// ════════════════════════════════════════════════════
// RENDER — RESUMOS
// ════════════════════════════════════════════════════
let resumoAtivo = RESUMOS[0].id;

function renderResumosTabs(){
  document.getElementById('resumos-tabs').innerHTML = RESUMOS.map(r=>`
    <button class="resumo-tab ${r.id===resumoAtivo?'active':''}" onclick="setResumo('${r.id}')">${r.label}</button>
  `).join('');
}

function setResumo(id){
  resumoAtivo = id;
  renderResumosTabs();
  renderResumoContent();
}

function renderBlockContent(c){
  if(c.type==='table') return `
    <div style="overflow-x:auto;border-radius:8px;margin-top:8px">
      <table class="resumo-table">
        <thead><tr>${c.headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead>
        <tbody>${c.rows.map(r=>`<tr>${r.map(cell=>`<td>${cell}</td>`).join('')}</tr>`).join('')}</tbody>
      </table>
    </div>`;
  if(c.type==='badge') return `
    ${c.label?`<div class="badge-section-label">${c.label}</div>`:''}
    <div class="badge-wrap">${c.items.map(it=>`<span class="badge">${it}</span>`).join('')}</div>`;
  if(c.type==='numbered') return `
    <div class="numbered-list">${c.items.map((it,i)=>`<div class="numbered-item"><span class="num-circle">${i+1}</span><span>${it}</span></div>`).join('')}</div>`;
  if(c.type==='alert') return `<div class="alert-box"><span>⚡</span><span>${c.text}</span></div>`;
  return '';
}

function renderResumoContent(){
  const r = RESUMOS.find(r=>r.id===resumoAtivo);
  if(!r) return;
  document.getElementById('resumos-content').innerHTML = `
    <div class="resumo-heading">
      <h2 class="resumo-heading-title font-display">${r.label}</h2>
      <span class="resumo-heading-tag" style="background:${r.tag}22;color:${r.tag}">Lâmina de Revisão</span>
    </div>
    <div class="bento-grid">
      ${r.cards.map(card=>`
        <div class="bento-card ${card.color}">
          <div class="bento-card-title">
            <span class="bento-card-icon">${card.icon}</span>
            <span>${card.title}</span>
          </div>
          ${card.content.map(renderBlockContent).join('')}
        </div>
      `).join('')}
    </div>
  `;
}

// ════════════════════════════════════════════════════
// INIT
// ════════════════════════════════════════════════════
function renderAll(){
  renderMetrics();
  renderTemas();
  renderQuestoes();
  document.getElementById('questoes-title').textContent = 'Todas as questões';
  renderResumosTabs();
  renderResumoContent();
}

// Initial state
document.getElementById('tab-simulado').style.display = 'block';
document.getElementById('tab-resumos').style.display = 'none';

// Enter key login
document.getElementById('login-input').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});
</script>
</body>
</html>
