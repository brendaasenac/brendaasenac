   {type:"alert",text:"DM1: iniciar rastreio após 5 anos do diagnóstico. DM2: iniciar ao diagnóstico."}
  ]},
  {color:"card-rose",icon:"💉",title:"Insulinoterapia",content:[
   {type:"table",headers:["Tipo","Início","Pico","Duração"],rows:[["Glargina (basal)","1-2h","Plano","20-24h"],["NPH (basal)","2-4h","6-10h","12-18h"],["Asparte/Lispro (bolus)","15min","1-2h","3-5h"],["Regular","30min","2-4h","6-8h"]]},
   {type:"alert",text:"Iniciar com NPH noturna 0,1 UI/kg bedtime. DM1: basal-bolus obrigatório."}
  ]}
 ]},
 {id:"ic",label:"Insuf. Cardíaca",tag:"#e11d48",cards:[
