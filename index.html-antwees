   {type:"badge",label:"Tratamento",items:["EH: Nitroprussiato EV, reduzir PAM 25% em 1h","UH: VO (captopril), redução gradual em 24-48h"]}
  ]}
 ]},
 {id:"dm",label:"Diabetes",tag:"#f59e0b",cards:[
  {color:"card-amber",icon:"🔬",title:"Diagnóstico",content:[
   {type:"table",headers:["Critério","Normal","Pré-DM","DM"],rows:[["Jejum","<100","100–125","≥126"],["TOTG 2h","<140","140–199","≥200"],["HbA1c","<5,7%","5,7–6,4%","≥6,5%"],["Aleatória","—","—","≥200+sintomas"]]},
   {type:"alert",text:"2 critérios positivos simultâneos dispensam repetição. DM1: jovem magro + poliúria + cetonúria = insulina imediata."}
  ]},
  {color:"card-blue",icon:"💊",title:"Tratamento DM2",content:[
   {type:"numbered",items:["1ª linha: METFORMINA + MEV","DCV estabelecida: + iSGLT2 ou aGLP-1","IC/DRC: iSGLT2 preferencial (dapagliflozina)","Obeso sem DCV: aGLP-1 (semaglutida, liraglutida)","HbA1c ≥10% sintomático: insulinizar"]},
   {type:"badge",label:"Ganho de peso (evitar em obesos)",items:["Sulfonilureias (2-5kg)","Insulinas (2-10kg)","Tiazolidinedionas (↑edema)"]}
  ]},
  {color:"card-emerald",icon:"🎯",title:"Rastreio de Complicações",content:[
