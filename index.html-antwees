   {type:"table",headers:["Tipo","FE","Etiologia comum"],rows:[["ICFEr","<40%","IAM, miocardiopatia"],["ICFEi","40-49%","Intermediária"],["ICFEp","≥50%","HAS, DM, obesidade"]]},
   {type:"table",headers:["NYHA","Sintomas"],rows:[["I","Assintomático"],["II","Esforços moderados"],["III","Esforços leves"],["IV","Repouso"]]}
  ]},
