   {type:"badge",label:"4 Pilares com evidência de mortalidade",items:["IECA ou ARNI (sacubitril/valsartana)","Betabloqueador (carvedilol, bisoprolol)","Antagonista aldosterona (espironolactona)","iSGLT2 (dapagliflozina, empagliflozina)"]},
   {type:"badge",label:"Apenas sintomáticos (não reduzem mortalidade)",items:["Diurético de alça (furosemida)","Digoxina (↓hospitalização)","Ivabradina (FC>70, ritmo sinusal)"]},
   {type:"alert",text:"CONTRAINDICADOS em ICFEr: Diltiazem, verapamil (BCC não-dihidropiridínicos). BCC na GESTAÇÃO com IC: PROIBIDOS IECA/BRA/espiro."}
  ]},
  {color:"card-blue",icon:"📊",title:"Framingham",content:[
   {type:"badge",label:"Critérios MAIORES",items:["DPN","Distensão jugular","Crepitações","Cardiomegalia","EAP, B3, PVC>16cm"]},
   {type:"badge",label:"Critérios MENORES",items:["Edema bilateral MMII","Tosse noturna","Dispneia a esforços","Hepatomegalia","Derrame pleural"]},
   {type:"alert",text:"Diagnóstico: 2 maiores OU 1 maior + 2 menores."}
  ]},
  {color:"card-teal",icon:"🤰",title:"IC na Gravidez",content:[
   {type:"badge",label:"SEGUROS na gestação",items:["Hidralazina","Nitrato","Digoxina","Furosemida (cautela)","Betabloqueador cardio-seletivo"]},
   {type:"alert",text:"PROIBIDOS na gestação: IECA, BRA, espironolactona, sacubitril-valsartana, BCC de ação curta."}
  ]}
 ]},
 {id:"dac",label:"DAC / SCA",tag:"#dc2626",cards:[
  {color:"card-rose",icon:"💓",title:"Angina Estável",content:[
   {type:"badge",label:"1ª Linha Anti-isquêmica",items:["Betabloqueador (1ª escolha)","BCC dihidropiridínico (anlodipino)","Nitrato de longa ação (sintomático)","Ivabradina (FC>70 + ritmo sinusal)","Trimetazidina (metabólico)"]},
   {type:"alert",text:"Trimetazidina: inibe metabolismo de ácidos graxos (usa glicose = mais eficiente na isquemia). SEM efeito hemodinâmico."}
  ]},
  {color:"card-orange",icon:"🚨",title:"SCA",content:[
   {type:"table",headers:["Tipo","ECG","Troponina","Conduta"],rows:[["IAMCSST","Supra ST","↑","Angioplastia <120min"],["IAMSST","Sem supra","↑","Estratificação de risco"],["AI","Sem supra","Normal","Clínico"]]},
   {type:"badge",label:"Terapia universal SCA",items:["AAS + P2Y12 (ticagrelor/clopidogrel)","Anticoagulação (heparina)","Estatina ALTA potência (TODOS, independente LDL)","BB + IECA (FE<40% ou DM)"]},
   {type:"alert",text:"BRE NOVO: NÃO é automático de IAM — dosar troponina antes de cateterismo."}
  ]},
  {color:"card-amber",icon:"📉",title:"Dislipidemia — Metas LDL",content:[
   {type:"table",headers:["Risco","Meta LDL"],rows:[["Baixo","<130 mg/dL"],["Intermediário","<100 mg/dL"],["Alto","<70 mg/dL"],["Muito alto","<50 mg/dL ou ↓≥50%"]]},
   {type:"badge",label:"Estatinas alta potência",items:["Atorvastatina 40-80mg","Rosuvastatina 20-40mg"]},
   {type:"alert",text:"FLUVASTATINA: menor potência entre as estatinas. FIBRATO: NÃO reduz mortalidade CV — apenas TG."}
  ]}
 ]},
 {id:"tireoid",label:"Tireoide",tag:"#059669",cards:[
  {color:"card-teal",icon:"🐌",title:"Hipotireoidismo",content:[
   {type:"table",headers:["Tipo","TSH","T4L"],rows:[["Primário manifesto","↑↑","↓"],["Subclínico","↑","Normal"],["Central","Normal/↓","↓"]]},
   {type:"badge",label:"Sintomas clássicos",items:["Fadiga, sonolência, lentificação","Constipação, pele seca, queda capilar","Bradicardia, reflexo tendíneo lento","Hipotermia, ganho de peso","Menorragia, amenorreia"]},
   {type:"alert",text:"Causa + comum: Hashimoto (anti-TPO+). Tratamento: levotiroxina — dose BAIXA em idosos/cardiopatas, titulação gradual."}
  ]},
  {color:"card-emerald",icon:"⚡",title:"Hipertireoidismo",content:[
